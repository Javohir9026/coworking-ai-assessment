# NestJS REST API base URL. The client stores UTC timestamps as ISO 8601 strings.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Interval used when polling simulated payment status after a payment request.
NUXT_PUBLIC_PAYMENT_POLLING_INTERVAL_MS=3000

NUXT_PUBLIC_APP_NAME=Coworking Reservation

# API must be running; the UI intentionally does not fall back to mock data.
# Frontend development server port.
NUXT_PORT=3001
